<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <!-- لوگو و عنوان -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JimSho VPN"
        android:textColor="@color/text_main"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure Tunnel Protocol"
        android:textColor="@color/text_sub"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        android:layout_marginTop="4dp"/>

    <!-- کادر سفید ورودی -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/configCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/card_white"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        android:layout_marginTop="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/secretKeyLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Secret Key"
                app:boxStrokeColor="@color/purple_main"
                app:hintTextColor="@color/purple_main">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/secretKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- نوار پیشرفت -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        app:indicatorColor="@color/purple_main"
        app:trackColor="#E5E7EB"
        app:trackCornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/configCard"
        android:layout_marginTop="20dp"
        android:visibility="gone"/>

    <!-- متن وضعیت (جایگزین باکس لاگ) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="آماده به کار"
        android:textColor="@color/text_sub"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="15dp"/>

    <!-- دکمه‌های استارت و استاپ -->
    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@+id/nekoBtn"
        android:layout_marginBottom="15dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="START"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="30dp"
            app:backgroundTint="@color/purple_main"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopBtn"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="STOP"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="30dp"
            app:backgroundTint="@color/btn_stop"
            android:layout_marginStart="8dp"
            android:enabled="false"/>
    </LinearLayout>

    <!-- دکمه اتصال به NekoBox -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/nekoBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="اتصال به NekoBox"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="30dp"
        app:backgroundTint="@color/purple_main"
        app:layout_constraintBottom_toTopOf="@id/copyLayout"
        android:layout_marginBottom="15dp"/>

    <!-- کارت کپی لینک‌های تلگرام -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/copyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/card_white"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/telegramText"
        android:layout_marginBottom="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کپی سریع پروکسی تلگرام:"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyLocalBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="کپی برای همین گوشی (Port 1080)"
                android:textSize="13sp"
                app:strokeColor="@color/purple_main"
                android:textColor="@color/purple_main"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyLanBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="کپی برای گوشی دیگر (Hotspot / Port 2080)"
                android:textSize="13sp"
                app:strokeColor="@color/purple_main"
                android:textColor="@color/purple_main"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- لینک تلگرام -->
    <TextView
        android:id="@+id/telegramText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="کانال تلگرام: @JimShoVPN"
        android:textColor="@color/telegram_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        android:autoLink="web"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="5dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
